@dataclass
class Step:
    skill: str                       # stats key
    desc: str                        # binding description (for key lookup)
    prompt: str
    check: Callable[[Snap], bool]
    target: Optional[str] = None     # tile letter to light up
    note: str = ""


@dataclass
class Exercise:
    id: str
    lesson: int
    skill: str
    builders: list                   # [fn(game, ctx) -> Step]


class Skip(Exception):
    """Raised by a builder when the current layout can't host this exercise."""


def pick_with_neighbor(g, d) -> tuple:
    s = g.snap
    options = [(t, neighbor(s, t, d)) for t in s.tiles.values()]
    options = [(t, n) for t, n in options if n]
    if not options:
        g.rebuild()
        s = g.snap
        options = [(t, neighbor(s, t, d)) for t in s.tiles.values()]
        options = [(t, n) for t, n in options if n]
    if not options:
        raise Skip()
    return random.choice(options)


def b_focus(d):
    desc = {"l": "Focus on left window", "r": "Focus on right window",
            "u": "Focus on above window", "d": "Focus on below window"}[d]

    def build(g, ctx):
        g.normalize()
        src, dst = pick_with_neighbor(g, d)
        g.focus(src.addr)
        start = g.snap.by_addr(src.addr)

        def check(s):
            a = s.active
            return bool(a and a.addr != start.addr and (a.addr == dst.addr or in_dir(start, a, d)))
        return Step(desc, desc, f"Move focus {DIR_WORD[d]}", check, target=dst.letter)
    return build


def b_focus_next(g, ctx):
    g.normalize()
    start = g.snap.active_addr

    def check(s):
        a = s.active
        return bool(a and a.addr != start and a.ws == g.practice)
    return Step("Focus on next window", "Focus on next window",
                "Cycle focus to the next window", check)


def b_swap(d):
    desc = {"l": "Swap window to the left", "r": "Swap window to the right",
            "u": "Swap window up", "d": "Swap window down"}[d]

    def build(g, ctx):
        g.normalize()
        src, _ = pick_with_neighbor(g, d)
        g.focus(src.addr)
        before = g.snap.by_addr(src.addr)

        def check(s):
            w = s.by_addr(before.addr)
            return bool(w and s.active_addr == w.addr and still_tiled(before, w) and moved_dir(before, w, d))
        return Step(desc, desc, f"Swap window {src.letter} {DIR_WORD[d]}", check, target=src.letter)
    return build


def b_split(g, ctx):
    g.normalize()
    t = random.choice(list(g.snap.tiles.values()))
    g.focus(t.addr)
    before = g.snap.by_addr(t.addr)

    def check(s):
        w = s.by_addr(before.addr)
        return bool(w and still_tiled(before, w) and (abs(w.w - before.w) > 10 or abs(w.h - before.h) > 10))
    return Step("Toggle window split", "Toggle window split",
                f"Flip the split of window {t.letter} (side-by-side ⇄ stacked)", check, target=t.letter)


def b_resize(desc, axis):
    def build(g, ctx):
        g.normalize()
        need = "lr" if axis == "w" else "ud"
        options = [t for t in g.snap.tiles.values() if any(neighbor(g.snap, t, d) for d in need)]
        if not options:
            g.rebuild()
            options = [t for t in g.snap.tiles.values() if any(neighbor(g.snap, t, d) for d in need)]
        if not options:
            raise Skip()
        t = random.choice(options)
        g.focus(t.addr)
        before = g.snap.by_addr(t.addr)

        def check(s):
            w = s.by_addr(before.addr)
            if not w or not still_tiled(before, w):
                return False
            return abs((w.w - before.w) if axis == "w" else (w.h - before.h)) >= 10
        return Step(desc, desc, f"{desc} (window {t.letter})", check, target=t.letter)
    return build


def other_ws(g, exclude) -> int:
    return random.choice([n for n in range(1, 10) if n not in exclude])


def empty_ws(g, exclude) -> int:
    used = {c.ws for c in g.snap.clients}
    choices = [n for n in range(1, 10) if n not in used and n not in exclude]
    return random.choice(choices or [n for n in range(1, 10) if n not in exclude])


def sandbox_ws(g, exclude=()) -> int:
    """A signpost workspace to send the player to (never one of their own)."""
    g.ensure_sandbox()
    choices = [n for n in g.sandbox if n not in exclude]
    return random.choice(choices) if choices else empty_ws(g, set(exclude) | {g.practice})


def b_ws_switch(g, ctx):
    g.normalize()
    n = sandbox_ws(g, {g.practice, g.snap.aws})
    return Step("Switch to workspace", f"Switch to workspace {n}",
                f"Switch to workspace {n}", lambda s: s.aws == n)


def b_ws_back_number(g, ctx):
    p = g.practice
    return Step("Switch to workspace", f"Switch to workspace {p}",
                f"Go back to workspace {p}", lambda s: s.aws == p)


def b_ws_former(g, ctx):
    p = g.practice
    if g.snap.aws == p:
        g.focus_ws(sandbox_ws(g, {p}))
        g.settle()
    return Step("Former workspace", "Former workspace",
                "Jump back to the workspace you were just on", lambda s: s.aws == p)


def b_ws_cycle(desc, prompt, step):
    """Super + Tab walks the open workspaces, which may include the player's own.
    Work out where the key will land and say so, so there are no surprises."""
    def build(g, ctx):
        g.normalize()
        g.ensure_sandbox()
        if step < 0:
            # Start on the signpost just above the tiles so "previous" comes home.
            above = [n for n in g.sandbox if n > g.practice]
            if above:
                g.focus_ws(min(above))
                g.settle()
        s = g.poll()
        order = s.open_workspaces()
        if s.aws not in order or len(order) < 2:
            raise Skip()
        dest = order[(order.index(s.aws) + step) % len(order)]
        where = "a signpost" if dest in g.sandbox else "the tiles" if dest == g.practice else "one of yours"
        return Step(desc, desc, f"{prompt} — that's {dest}, {where}", lambda s: s.aws == dest)
    return build


def b_move_ws(follow):
    def build(g, ctx):
        g.normalize()
        t = random.choice(list(g.snap.tiles.values()))
        g.focus(t.addr)
        n = sandbox_ws(g, {g.practice})
        ctx.update(tile=t.letter, addr=t.addr, ws=n)
        p = g.practice
        if follow:
            desc, skill = f"Move window to workspace {n}", "Move window to workspace"
            prompt = f"Send window {t.letter} to workspace {n} — and follow it"
        else:
            desc, skill = f"Move window silently to workspace {n}", "Move window silently to workspace"
            prompt = f"Send window {t.letter} to workspace {n} silently (stay here)"

        def check(s):
            w = s.by_addr(t.addr)
            return bool(w and w.ws == n and s.aws == (n if follow else p))
        return Step(skill, desc, prompt, check, target=t.letter)
    return build


def b_move_home(g, ctx):
    p, addr = g.practice, ctx["addr"]
    w = g.snap.by_addr(addr)
    if not w:
        raise Skip()
    if g.snap.active_addr != addr:
        g.focus(addr)

    def check(s):
        x = s.by_addr(addr)
        return bool(x and x.ws == p and s.aws == p)
    return Step("Move window to workspace", f"Move window to workspace {p}",
                f"Bring window {ctx['tile']} home: move it to workspace {p}", check, target=ctx["tile"])


def b_mode(desc, on_prompt, off_prompt, pred):
    """Two-step exercise: turn a window state on, then off again with the same key."""
    def on(g, ctx):
        g.normalize()
        t = random.choice(list(g.snap.tiles.values()))
        g.focus(t.addr)
        ctx.update(addr=t.addr, tile=t.letter)

        def check(s):
            w = s.by_addr(t.addr)
            return bool(w and pred(w))
        return Step(desc, desc, on_prompt.format(t.letter), check, target=t.letter)

    def off(g, ctx):
        addr = ctx["addr"]
        w = g.snap.by_addr(addr)
        if not w or not pred(w):
            raise Skip()
        if g.snap.active_addr != addr:
            g.focus(addr)

        def check(s):
            x = s.by_addr(addr)
            return bool(x and not pred(x))
        return Step(desc, desc, off_prompt.format(ctx["tile"]), check, target=ctx["tile"])
    return [on, off]


def b_close(g, ctx):
    g.normalize()
    t = random.choice(list(g.snap.tiles.values()))
    g.focus(t.addr)
    return Step("Close window", "Close window", f"Close window {t.letter}",
                lambda s: s.by_addr(t.addr) is None, target=t.letter)


def b_terminal(g, ctx):
    g.normalize()

    def check(s):
        new = s.strays()
        if new:
            ctx["addr"] = new[0].addr
            return True
        return False
    return Step("Terminal", "Terminal", "Open a new terminal", check)


def b_close_new(g, ctx):
    addr = ctx.get("addr")
    if not addr or not g.snap.by_addr(addr):
        raise Skip()
    if g.snap.active_addr != addr:
        g.focus(addr)
    return Step("Close window", "Close window", "Close that terminal again",
                lambda s: s.by_addr(addr) is None)


def b_layout_on(g, ctx):
    g.normalize()
    p = g.practice
    return Step("Toggle workspace layout", "Toggle workspace layout",
                "Switch this workspace to the scrolling layout",
                lambda s: s.layout(p) != "dwindle", note="Scrolling lays windows out as a horizontal strip of columns.")


def b_layout_off(g, ctx):
    p = g.practice
    if g.snap.layout(p) == "dwindle":
        raise Skip()
    return Step("Toggle workspace layout", "Toggle workspace layout",
                "Switch back to the dwindle (tiling) layout", lambda s: s.layout(p) == "dwindle")


def make_group(g):
    """Group two adjacent tiles. Returns (group_window_addr, member_addr)."""
    d = random.choice(DIRS)
    a, b = pick_with_neighbor(g, d)
    g.focus(b.addr)
    g.dispatch("hl.dsp.group.toggle()")
    g.focus(a.addr)
    g.dispatch(f'hl.dsp.window.move({{ into_group = "{d}" }})')
    g.poll()
    w = g.snap.by_addr(a.addr)
    if not w or len(w.grouped) < 2:
        raise Skip()
    return a, b


def b_group_toggle_on(g, ctx):
    g.normalize()
    t = random.choice(list(g.snap.tiles.values()))
    g.focus(t.addr)
    ctx.update(addr=t.addr, tile=t.letter)
    return Step("Toggle window grouping", "Toggle window grouping",
                f"Turn window {t.letter} into a group (tabbed container)",
                lambda s: bool(s.by_addr(t.addr) and s.by_addr(t.addr).grouped), target=t.letter)


def b_group_toggle_off(g, ctx):
    addr = ctx["addr"]
    w = g.snap.by_addr(addr)
    if not w or not w.grouped:
        raise Skip()
    return Step("Toggle window grouping", "Toggle window grouping", "Dissolve that group again",
                lambda s: bool(s.by_addr(addr) and not s.by_addr(addr).grouped), target=ctx["tile"])


def b_group_join(d):
    desc = {"l": "Move window to group on left", "r": "Move window to group on right",
            "u": "Move window to group on top", "d": "Move window to group on bottom"}[d]

    def build(g, ctx):
        g.normalize()
        member, grp = pick_with_neighbor(g, d)
        g.focus(grp.addr)
        g.dispatch("hl.dsp.group.toggle()")
        g.focus(member.addr)

        def check(s):
            w = s.by_addr(member.addr)
            return bool(w and (grp.addr in w.grouped or len(w.grouped) >= 2))
        return Step(desc, desc, f"Move window {member.letter} into the group {DIR_WORD[d]}",
                    check, target=grp.letter, note=f"Window {grp.letter} is already a group.")
    return build


def b_group_cycle(g, ctx):
    g.normalize()
    a, b = make_group(g)
    start = g.snap.active_addr

    def check(s):
        x = s.active
        return bool(x and x.addr != start and start in x.grouped)
    return Step("Next window in group", "Next window in group",
                "Flip to the next tab in this group", check)


def b_group_leave(g, ctx):
    g.normalize()
    a, b = make_group(g)
    start = g.snap.active_addr

    def check(s):
        w = s.by_addr(start)
        return bool(w and not w.grouped)
    return Step("Move active window out of group", "Move active window out of group",
                "Pull this window out of its group", check)


def b_scratch_send(g, ctx):
    g.normalize()
    t = random.choice(list(g.snap.tiles.values()))
    g.focus(t.addr)
    ctx.update(addr=t.addr, tile=t.letter)
    return Step("Move window to scratchpad", "Move window to scratchpad",
                f"Stash window {t.letter} in the scratchpad",
                lambda s: bool(s.by_addr(t.addr) and s.by_addr(t.addr).ws_name.startswith("special")),
                target=t.letter)


def b_scratch_show(g, ctx):
    w = g.snap.by_addr(ctx.get("addr"))
