    return Step("Toggle scratchpad", "Toggle scratchpad", f"Pop the scratchpad open to see {ctx['tile']}",
                lambda s: s.special.startswith("special"))


def b_scratch_hide(g, ctx):
    return Step("Toggle scratchpad", "Toggle scratchpad", "Hide the scratchpad again",
                lambda s: not s.special)


