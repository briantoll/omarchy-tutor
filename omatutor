# ─── Hyprland IPC ──────────────────────────────────────────────────────────

class Hypr:
    def __init__(self):
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        if not sig:
            sys.exit("omatutor must run inside a Hyprland session.")
        self.sock = os.path.join(os.environ["XDG_RUNTIME_DIR"], "hypr", sig, ".socket.sock")

    def _request(self, cmd: str) -> str:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.connect(self.sock)
            s.sendall(cmd.encode())
            chunks = []
            while True:
                data = s.recv(65536)
                if not data:
                    break
                chunks.append(data)
            return b"".join(chunks).decode(errors="replace")
        finally:
            s.close()

    def query(self, what: str):
        try:
            return json.loads(self._request("j/" + what))
        except (OSError, json.JSONDecodeError):
            out = subprocess.run(["hyprctl", what, "-j"], capture_output=True, text=True).stdout
            return json.loads(out or "null")

    def dispatch(self, lua: str) -> str:
        r = subprocess.run(["hyprctl", "dispatch", lua], capture_output=True, text=True)
        return r.stdout.strip()

    def eval(self, lua: str) -> str:
        r = subprocess.run(["hyprctl", "eval", lua], capture_output=True, text=True)
        return r.stdout.strip()


def lua_str(s: str) -> str:
    return json.dumps(s)


