def load_keys() -> dict:
    keys = dict(DEFAULT_KEYS)
    if not shutil.which("omarchy-menu-keybindings"):
        return keys
    try:
        out = subprocess.run(["omarchy-menu-keybindings", "--print"], capture_output=True,
                             text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return keys
    seen = set()
    for line in out.splitlines():
        if "→" not in line:
            continue
        combo, desc = (p.strip() for p in line.split("→", 1))
        if "mouse" in combo.lower() or desc in seen:
            continue
        seen.add(desc)
        keys[desc] = combo
    return keys


def theme_accent() -> Optional[tuple]:
    """The active Omarchy theme's accent colour as (r, g, b), or None."""
    try:
        with open(THEME_COLORS) as f:
            for line in f:
                m = re.match(r'\s*accent\s*=\s*"#([0-9a-fA-F]{6})"', line)
                if m:
                    h = m.group(1)
                    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
    except OSError:
        pass
    return None


def nearest_xterm256(r, g, b) -> int:
    """Closest entry in the xterm 256-colour cube/ramp, for terminals whose palette
    can't be changed."""
    steps = [0, 95, 135, 175, 215, 255]
    best, best_d = 7, None
    for i, cr in enumerate(steps):
        for j, cg in enumerate(steps):
            for k, cb in enumerate(steps):
                d = (cr - r) ** 2 + (cg - g) ** 2 + (cb - b) ** 2
                if best_d is None or d < best_d:
                    best, best_d = 16 + 36 * i + 6 * j + k, d
    for n in range(24):
        v = 8 + 10 * n
        d = 3 * (v - r) ** 2 if r == g == b else (v - r) ** 2 + (v - g) ** 2 + (v - b) ** 2
        if d < best_d:
            best, best_d = 232 + n, d
    return best


def key_caps(combo: str) -> list:
    """'SUPER SHIFT + 3' -> ['Super', 'Shift', '3']"""
    mods, _, key = combo.rpartition("+")
    parts = mods.split() + [key.strip()]
    return [KEY_NAMES.get(p.upper(), p) for p in parts if p]


