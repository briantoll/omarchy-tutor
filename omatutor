@dataclass
class Win:
    raw: dict

    @property
    def addr(self): return self.raw["address"]
    @property
    def title(self): return self.raw.get("title", "")
    @property
    def ws(self): return self.raw["workspace"]["id"]
    @property
    def ws_name(self): return self.raw["workspace"]["name"]
    @property
    def floating(self): return self.raw.get("floating", False)
    @property
    def pinned(self): return self.raw.get("pinned", False)
    @property
    def fullscreen(self): return self.raw.get("fullscreen", 0)
    @property
    def fs_client(self): return self.raw.get("fullscreenClient", 0)
    @property
    def grouped(self): return self.raw.get("grouped", []) or []
    @property
    def hidden(self): return self.raw.get("hidden", False)
    @property
    def x(self): return self.raw["at"][0]
    @property
    def y(self): return self.raw["at"][1]
    @property
    def w(self): return self.raw["size"][0]
    @property
    def h(self): return self.raw["size"][1]
    @property
    def cx(self): return self.x + self.w / 2
    @property
    def cy(self): return self.y + self.h / 2

    @property
    def letter(self) -> Optional[str]:
        t = self.title
        if t.startswith(TITLE_PREFIX) and len(t) == len(TITLE_PREFIX) + 1:
            return t[-1]
        return None

    @property
    def signpost(self) -> Optional[int]:
        """Workspace number if this is one of the tutor's signpost windows."""
        t = self.title
        if t.startswith(TITLE_PREFIX + "ws") and t[len(TITLE_PREFIX) + 2:].isdigit():
            return int(t[len(TITLE_PREFIX) + 2:])
        return None


class Snap:
    def __init__(self, h: Hypr, practice: int):
        self.practice = practice
        self.clients = [Win(c) for c in (h.query("clients") or []) if c.get("mapped", True)]
        aw = h.query("activewindow") or {}
        self.active_addr = aw.get("address")
        self.aws = (h.query("activeworkspace") or {}).get("id")
        mons = h.query("monitors") or []
        self.monitors = mons
        focused = next((m for m in mons if m.get("focused")), mons[0] if mons else {})
        self.monitor = focused
        self.special = (focused.get("specialWorkspace") or {}).get("name", "")
        self.workspaces = {w["id"]: w for w in (h.query("workspaces") or [])}

    def by_addr(self, addr) -> Optional[Win]:
        return next((c for c in self.clients if c.addr == addr), None)

    @property
    def active(self) -> Optional[Win]:
        return self.by_addr(self.active_addr)

    @property
    def hud(self) -> Optional[Win]:
        return next((c for c in self.clients if c.title == HUD_TITLE), None)

    @property
    def tiles(self) -> dict:
        return {c.letter: c for c in self.clients if c.letter}

    def tile(self, letter) -> Optional[Win]:
        return self.tiles.get(letter)

    @property
    def signposts(self) -> dict:
        return {c.signpost: c for c in self.clients if c.signpost}

    def strays(self) -> list:
        return [c for c in self.clients if c.ws == self.practice and not c.letter
                and not c.signpost and c.title != HUD_TITLE]

    def open_workspaces(self) -> list:
        """Ids of the workspaces Super + Tab cycles through: the ones with windows on
        the focused monitor, in order."""
        mon = self.monitor.get("name")
        ids = {w["id"] for w in self.workspaces.values()
               if w.get("id", 0) > 0 and w.get("windows", 0) > 0 and (not mon or w.get("monitor") == mon)}
        if self.aws and self.aws > 0:
            ids.add(self.aws)
        return sorted(ids)

    def layout(self, ws) -> str:
        return (self.workspaces.get(ws) or {}).get("tiledLayout", "dwindle")

    def tiled_on(self, ws) -> list:
        return [c for c in self.clients
                if c.ws == ws and not c.floating and not c.hidden and c.title != HUD_TITLE]

    def fingerprint(self):
        """Discrete state used to notice 'you did something, but not that'."""
        wins = tuple(sorted((c.addr, c.ws, c.floating, c.fullscreen, c.fs_client, c.pinned,
                             len(c.grouped)) for c in self.clients if c.title != HUD_TITLE))
        return (self.active_addr, self.aws, self.special, self.layout(self.practice), wins)

    def geometry(self):
        return tuple(sorted((c.addr, c.x, c.y, c.w, c.h) for c in self.clients if c.letter))


DIRS = "lrud"
DIR_WORD = {"l": "LEFT ←", "r": "RIGHT →", "u": "UP ↑", "d": "DOWN ↓"}


def in_dir(src: Win, dst: Win, d: str, tol=4) -> bool:
    if d == "l": return dst.x + dst.w <= src.x + tol and overlap(src.y, src.h, dst.y, dst.h)
    if d == "r": return dst.x >= src.x + src.w - tol and overlap(src.y, src.h, dst.y, dst.h)
    if d == "u": return dst.y + dst.h <= src.y + tol and overlap(src.x, src.w, dst.x, dst.w)
    return dst.y >= src.y + src.h - tol and overlap(src.x, src.w, dst.x, dst.w)


def overlap(a, al, b, bl) -> bool:
    return min(a + al, b + bl) - max(a, b) > 0


def neighbor(snap: Snap, src: Win, d: str) -> Optional[Win]:
    cands = [c for c in snap.tiled_on(src.ws) if c.addr != src.addr and in_dir(src, c, d)]
    if not cands:
        return None
    return min(cands, key=lambda c: abs(c.cx - src.cx) + abs(c.cy - src.cy))


def still_tiled(before: Win, after: Win) -> bool:
    """Geometry checks only count while the window stays a plain tile on the same workspace."""
    return (not after.floating and not after.fullscreen and not after.grouped
            and after.ws == before.ws)


def moved_dir(before: Win, after: Win, d: str, min_px=20) -> bool:
    dx, dy = after.cx - before.cx, after.cy - before.cy
    return {"l": -dx, "r": dx, "u": -dy, "d": dy}[d] >= min_px


# ─── Terminal spawning ─────────────────────────────────────────────────────

def terminal_cmd(title: str, argv: list) -> str:
    """Build a shell command that opens `argv` in the user's terminal with a fixed title."""
    preferred = []
    try:
        with open(os.path.expanduser("~/.config/xdg-terminals.list")) as f:
            preferred = [l.strip().lower() for l in f if l.strip() and not l.startswith("#")]
    except OSError:
        pass
    order = []
    for entry in preferred:
        for name in ("foot", "alacritty", "kitty", "ghostty"):
            if name in entry and name not in order:
                order.append(name)
    order += [n for n in ("foot", "alacritty", "kitty", "ghostty") if n not in order]
    term = next((n for n in order if shutil.which(n)), None)
    if not term:
        sys.exit("No supported terminal found (foot, alacritty, kitty or ghostty).")
    q = " ".join(_shq(a) for a in argv)
    t = _shq(title)
    return {
        "foot": f"foot --app-id={APP} --title={t} {q}",
        "alacritty": f"alacritty --class {APP} --title {t} -e {q}",
        "kitty": f"kitty --class {APP} --title {t} {q}",
        "ghostty": f"ghostty --class=com.omarchy.tutor --title={t} -e {q}",
    }[term]


def _shq(s: str) -> str:
    return "'" + s.replace("'", "'\\''") + "'"


